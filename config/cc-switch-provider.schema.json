{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi CC Switch provider local configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "codexSummary": {
      "$ref": "#/$defs/codexSummary"
    }
  },
  "$defs": {
    "codexSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "authRef"],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "authRef": {
          "type": "string",
          "enum": [
            "cc-switch-proxy",
            "env:PI_CC_SWITCH_CODEX_SUMMARY_API_KEY"
          ]
        }
      }
    }
  }
}
